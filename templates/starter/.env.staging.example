# Staging settings. Copy to .env.staging on the server. Never commit it.
# Staging runs next to production on the same host, from the same compose.yaml.

# Tip of main, rebuilt by CI on every merge.
IMAGE_TAG=staging
CONTAINER_NAME={{SLUG}}-staging

# Production has 8080; staging takes the next port, also reachable from the web server only.
PUBLISH_PORT=127.0.0.1:8081
