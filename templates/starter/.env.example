# Production settings. Copy to .env on the server. Never commit .env.

# Only reachable from the web server (Caddy) on this host, never directly from the internet.
# For testing on your own machine or LAN, use PUBLISH_PORT=8080 instead.
PUBLISH_PORT=127.0.0.1:8080

# Which published image to run: latest = newest release. Pin a tag (for example v1.2.0)
# to hold production still or roll back; deploy/update.sh then leaves it alone.
IMAGE_TAG=latest
